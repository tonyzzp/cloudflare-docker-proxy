/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-docker-proxy",
	"main": "src/index.js",
	"compatibility_date": "2025-12-21",
	"observability": {
		"enabled": true
	},
	"vars":{
		"CUSTOM_DOMAIN": "docker.izzp.me",
		"MODE": "production",
	},
	"routes":[
		{"pattern":"*.docker.izzp.me/*", "zone_name":"izzp.me"},
		{"pattern":"docker.docker.izzp.me", "custom_domain":true},
		{"pattern":"ghcr.docker.izzp.me", "custom_domain":true},
		{"pattern":"quay.docker.izzp.me", "custom_domain":true},
		{"pattern":"gcr.docker.izzp.me", "custom_domain":true},
		{"pattern":"k8s-gcr.docker.izzp.me", "custom_domain":true},
		{"pattern":"k8s.docker.izzp.me", "custom_domain":true}
	]
}